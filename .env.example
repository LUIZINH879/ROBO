# ===============================================
# CONFIGURAÇÕES DO ROBÔ DE TRADING (Termux / Mobile)
# ===============================================

# Corretora (padrão: binance)
CCXT_EXCHANGE=binance

# Chaves de API da Binance (Obtenha em: Binance > Perfil > Gerenciamento de API)
# Para modo PAPER (Simulação), não precisa preencher!
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=

# Banco de Dados SQLite (Armazenamento leve local)
DATABASE_URL=sqlite+aiosqlite:///trading_bot.db

# Parâmetros de Mercado
HISTORICAL_LIMIT=200
NETWORK_TIMEOUT=15
REST_MAX_RETRIES=5

# Gerenciamento de Risco (Limite de capital por operação)
# Exemplo: 0.00005 BTC ≈ R$ 5,00 a R$ 6,00
MAX_POSITION=0.00005
MAX_DRAWDOWN=0.30

# Nível de Logs
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
