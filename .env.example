# .env.example
# Copy this file to .env and fill in your credentials.

# ---------- CCXT ----------
# Exchange identifier as used by CCXT (e.g., binance, kraken, bitfinex)
CCXT_EXCHANGE=binance
# API credentials – leave empty for public data access (historical OHLCV)
CCXT_API_KEY=
CCXT_SECRET=
CCXT_PASSWORD=

# ---------- Database ----------
# SQLite file (default) or PostgreSQL URL
# Example PostgreSQL: postgresql+asyncpg://user:password@localhost/trading_bot
DATABASE_URL=sqlite+aiosqlite:///trading_bot.db

# ---------- Data pipeline ----------
# Number of historical candles to download on start
HISTORICAL_LIMIT=5000
# Network timeout in seconds for all HTTP/WebSocket calls
NETWORK_TIMEOUT=10
# Maximum retries for REST calls
REST_MAX_RETRIES=5
# WebSocket reconnection back‑off (seconds)
WS_RETRY_INITIAL=1
WS_RETRY_MAX=30

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
